# WhatsApp Business Platform sender credentials from Meta Developer dashboard.
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Shop notification recipient; India country code 91 plus the provided number.
WHATSAPP_TO=918438606950

# Approved Meta Utility template with 7 body parameters.
WHATSAPP_TEMPLATE_NAME=new_order_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Shipping charge shown at checkout, in INR. India rate ₹150. International courier ₹700 per kg, minimum one kg.
SHIPPING_FEE_INR=150
# International courier rate: INR per started kg, minimum one kg.
INTERNATIONAL_RATE_PER_KG_INR=700
