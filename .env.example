# WhatsApp Business Platform sender credentials from Meta Developer dashboard.
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Meta App Dashboard > App settings > Basic > App Secret; and Webhooks > Verify token.
META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Shop notification recipient; India country code 91 plus the provided number.
WHATSAPP_TO=918438606950

# Public HTTPS URL of the deployed Node service. The Meta URL button must use this base plus /approve/{{1}}.
PUBLIC_SITE_URL=

# Approved Meta WhatsApp template with 7 body parameters and a dynamic URL button.
# Body: {{1}}. Customer: {{2}}. Phone: {{3}}. Delivery address: {{4}}. Items: {{5}}. Total: {{6}}. {{7}}
# Variable 1 identifies a PhonePe payment already verified, or an order awaiting manual payment checking.
WHATSAPP_TEMPLATE_NAME=new_order_approval
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Optional one-tap shop approval template. Create and get approval in WhatsApp Manager
# with the same 7 body fields and one Quick Reply button labeled "Approve order".
# When set, the WhatsApp reply webhook approves the matching order and messages the customer.
WHATSAPP_APPROVAL_QUICK_REPLY_TEMPLATE_NAME=

# Approved WhatsApp template for a website visit alert; body: A visitor opened {{1}} at {{2}}.
WHATSAPP_VISIT_TEMPLATE_NAME=website_visit_alert
WHATSAPP_VISIT_TEMPLATE_LANGUAGE=en_US

# Strong private token for /admin.html (use a random value with at least 32 characters).
ADMIN_APPROVAL_TOKEN=

# Approved Meta Utility template sent to the customer only after the shop approves payment.
# Template body: Your order {{1}} is confirmed. Payment {{2}} is verified. Expected delivery: {{3}} to {{4}}.
WHATSAPP_APPROVED_TEMPLATE_NAME=order_approved
WHATSAPP_APPROVED_TEMPLATE_LANGUAGE=en_US

# Expected delivery window (calendar days after approval).
DOMESTIC_DELIVERY_MIN_DAYS=5
DOMESTIC_DELIVERY_MAX_DAYS=7
INTERNATIONAL_DELIVERY_MIN_DAYS=10
INTERNATIONAL_DELIVERY_MAX_DAYS=14

# PhonePe PG credentials from your verified PhonePe Business merchant dashboard.
# Keep these private; add them to Render Environment Variables, not HTML or Git.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_ENV=SANDBOX
# Configure the same webhook username/password in the PhonePe dashboard (SHA authentication).
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Chennai PINs beginning 600: ₹60; other India destinations: ₹120.
CHENNAI_DELIVERY_FEE_INR=60
DOMESTIC_DELIVERY_FEE_INR=120
# International delivery is quoted separately; checkout shows Applicable only.
